#include <stdio.h>

struct Funcionario {
    int codigo;
    char nome[50];
    char cargo[30];
    float salarioBase;
    int horasExtras;
};

int main() {
    struct Funcionario funcionarios[8];
    int qtdFuncionarios, i, indiceMaiorSalario = 0;
    float valorHora, valorHoraExtra, salarioBruto, desconto, salarioLiquido;
    float maiorSalarioLiquido = 0, custoTotalFolha = 0;

    printf("Quantidade de funcionarios (ate 8): ");
    scanf("%d", &qtdFuncionarios);
    if (qtdFuncionarios > 8) {
        qtdFuncionarios = 8;
    }

    for (i = 0; i < qtdFuncionarios; i++) {
        printf("\nFuncionario %d\n", i + 1);
        printf("Codigo: ");
        scanf("%d", &funcionarios[i].codigo);
        printf("Nome: ");
        scanf(" %[^\n]", funcionarios[i].nome);
        printf("Cargo: ");
        scanf(" %[^\n]", funcionarios[i].cargo);
        printf("Salario base: ");
        scanf("%f", &funcionarios[i].salarioBase);
        printf("Horas extras: ");
        scanf("%d", &funcionarios[i].horasExtras);
    }

    printf("\nFolha de pagamento:\n");
    for (i = 0; i < qtdFuncionarios; i++) {
        valorHora = funcionarios[i].salarioBase / 160.0;
        valorHoraExtra = valorHora * 1.5;
        salarioBruto = funcionarios[i].salarioBase + (funcionarios[i].horasExtras * valorHoraExtra);
        desconto = salarioBruto * 0.10;
        salarioLiquido = salarioBruto - desconto;

        printf("%s (%s) - Bruto: R$ %.2f | Liquido: R$ %.2f\n",
               funcionarios[i].nome, funcionarios[i].cargo, salarioBruto, salarioLiquido);

        custoTotalFolha += salarioLiquido;
        if (i == 0 || salarioLiquido > maiorSalarioLiquido) {
            maiorSalarioLiquido = salarioLiquido;
            indiceMaiorSalario = i;
        }
    }

    if (qtdFuncionarios > 0) {
        printf("\nMaior salario liquido: %s (R$ %.2f)\n", funcionarios[indiceMaiorSalario].nome, maiorSalarioLiquido);
        printf("Custo total da folha: R$ %.2f\n", custoTotalFolha);
    }

    return 0;
}
